<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      默认离线，打卡/激励数据仅存本地。
      INTERNET 仅在用户主动开启「墨墨背单词同步」或未来的 AI 助手时使用，
      不配置任何后台自动联网。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- AI 回答生成期间的保活前台服务（防止熄屏/切后台后进程被冻结或查杀导致输出丢失） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- AI 助手个性化：粗略定位（只取大致位置反解城市，用户可不用） -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 应用内更新：用系统 DownloadManager 下载新版本 APK + 静默安装。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Android 11+ package visibility for the system speech recognition service. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".LiXingApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LiXing"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.LiXing"
            android:screenOrientation="fullUser"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|fontScale|fontWeightAdjustment">
            <!--
              screenOrientation=fullUser：明确声明支持全部四个方向（含反向横/竖屏）。
              不声明时系统按 unspecified 处理，平板等大屏设备上会被套用「方向/信箱兼容模式」
              强制竖屏；这里显式声明后系统不再替我们做方向裁剪。

              configChanges：旋转、分屏、窗口尺寸变化不再销毁重建 Activity。
              Compose 会自行在配置变化时重组，重建反而会丢掉输入框内容、列表滚动位置、
              以及「正在等相机返回」的临时文件路径。
              未声明 locale / uiMode：语言、深浅色切换仍走系统重建，避免资源未刷新。
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 百度 OAuth 完成后，Worker 只用一次性 ticket 唤回 App，不在 URL 中暴露 Token。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="lixing"
                    android:host="oauth"
                    android:path="/baidu" />
            </intent-filter>
        </activity>

        <!-- 打卡拍照用 FileProvider，把照片写到应用私有目录 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 时段提醒闹钟接收器 -->
        <receiver
            android:name=".reminder.SlotReminderReceiver"
            android:exported="false" />

        <!-- AI 回答生成期间的保活前台服务：只在用户主动发送消息时由前台启动 -->
        <service
            android:name=".assistant.AssistantKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 开机 / 应用更新后重排闹钟 -->
        <receiver
            android:name=".reminder.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 应用内更新：接收系统 DownloadManager 的下载完成广播 -->
        <receiver
            android:name=".data.update.DownloadCompleteReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>

        <!-- WorkManager 使用 Hilt 自定义初始化，关闭默认初始化器 -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
